{
    "name": "witals/framework",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["witals"],
    "autoload": {
        "psr-4": {
            "Witals\\Framework\\": "src/",
            "App\\": "app/",
            "Modules\\": "modules/"
        },
        "files": [
            "app/Support/helpers.php",
            "src/Module/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Puleeno Nguyen",
            "email": "puleeno@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/log": "^3.0",
        "paragonie/paseto": "^2.0",
        "spiral/roadrunner-http": "^3.0",
        "spiral/roadrunner-worker": "^3.0",
        "nyholm/psr7": "^1.8",
        "vlucas/phpdotenv": "^5.5",
        "cycle/orm": "^2.0",
        "cycle/database": "^2.0",
        "cycle/annotated": "^3.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "spiral/stempler": "^3.17",
        "laravel/serializable-closure": "2.x",
        "spiral/data-grid": "^3.0",
        "cakephp/chronos": "3.x",
        "symfony/http-client": "6.4.x"
    },
    "suggest": {
        "react/http": "Required for ReactPHP runtime support (^1.9)",
        "react/event-loop": "Required for ReactPHP runtime support (^1.4)",
        "ext-swoole": "Required for Swoole runtime support (^5.0)",
        "ext-openswoole": "Required for OpenSwoole runtime support (^22.0)",
        "predis/predis": "Required for Redis queue driver support (^2.0)",
        "ext-redis": "Alternative to predis/predis for Redis queue driver support"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    }
}